**/node_modules
**/dist
.git
.github
**/test-results
**/playwright-report
**/coverage
**/.env*
!**/.env.example
**/*.db
**/*.db-*
**/*.db.*
**/data
.cosimo
**/*.tsbuildinfo
**/*.bun-build
**/.DS_Store
graphify-out
Dockerfile
.dockerignore
