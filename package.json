{
  "name": "cosimo-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "test:sqld": "COSIMO_TEST_DB=sqld bun test",
    "check": "bun run lint && bun run typecheck && bun run test && bun run test:sqld",
    "dev": "bun run --cwd apps/server dev",
    "build:web": "bun run --cwd apps/web build",
    "build:binary": "bun run build:web && bun run --cwd apps/server build:binary",
    "e2e": "bunx playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.2",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2"
  }
}
